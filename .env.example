# Build configuration. All values are validated at build time
# (src/config/build-env.ts). Without values, local defaults apply.

# Absolute site origin, without trailing slash.
SITE_URL=http://localhost:4321

# Base path the site is served under: "/" or e.g. "/grundner.io-website".
BASE_PATH=/

# "true" adds <meta name="robots" content="noindex, nofollow"> to every page.
SITE_NOINDEX=true
