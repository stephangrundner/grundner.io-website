---
import "../styles/global.css";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Exclude this page from search engines regardless of SITE_NOINDEX. */
  noindex?: boolean;
  ogType?: "website" | "article";
  /** JSON-LD structured data for this page. */
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  noindex = false,
  ogType = "website",
  structuredData,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const excludeFromSearch = __SITE_NOINDEX__ || noindex;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {excludeFromSearch && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Zum Inhalt springen
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import "../scripts/reveal.ts";
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 30;
    padding: var(--space-3) var(--space-4);
    background: var(--ink);
    color: var(--on-dark);
    font-weight: var(--fw-semibold);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
    color: var(--on-dark);
  }

  main:focus {
    outline: none;
  }
</style>
