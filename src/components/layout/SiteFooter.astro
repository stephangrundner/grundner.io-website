---
import {
  legalNavigation,
  mainNavigation,
  utilityNavigation,
} from "../../data/navigation";
import { site } from "../../data/site";
import { withBase } from "../../lib/url";
import Wordmark from "../ui/Wordmark.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a href={withBase("/")} class="site-footer__home" aria-label="Startseite">
        <Wordmark withDescriptor />
      </a>
      <p class="site-footer__claim">{site.claim}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Fußnavigation">
      <ul class="site-footer__list">
        {[...mainNavigation, utilityNavigation].map((link) => (
          <li>
            <a href={withBase(link.href)}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__meta">
      <span>
        © {year} {site.name}
      </span>
      <ul class="site-footer__legal">
        {legalNavigation.map((link) => (
          <li>
            <a href={withBase(link.href)}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--hairline);
    background: var(--bg-page);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-8);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-16) var(--gutter) var(--space-8);
  }

  .site-footer__home,
  .site-footer__home:hover {
    text-decoration: none;
  }

  .site-footer__home {
    display: inline-flex;
    min-height: var(--touch-min);
    color: var(--text-body);
  }

  .site-footer__claim {
    margin-top: var(--space-4);
    max-width: 36ch;
    hyphens: manual;
    font-size: var(--fs-body-sm);
    line-height: var(--lh-lead);
  }

  .site-footer__list,
  .site-footer__legal {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-6);
  }

  .site-footer__list a {
    display: flex;
    align-items: center;
    min-height: var(--touch-min);
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-medium);
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: var(--hairline);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-meta);
  }

  .site-footer__legal {
    display: flex;
    gap: var(--space-6);
  }

  .site-footer__legal a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--text-meta);
  }

  @media (min-width: 1024px) {
    .site-footer__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-8);
    }

    .site-footer__brand {
      grid-column: 1 / span 5;
    }

    .site-footer__nav {
      grid-column: 8 / span 5;
    }

    .site-footer__meta {
      grid-column: 1 / -1;
    }
  }
</style>
