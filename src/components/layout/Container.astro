---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Readable text width instead of the full content width. */
  width?: "content" | "measure";
}

const { width = "content", class: className, ...rest } = Astro.props;
---

<div class:list={["container", `container--${width}`, className]} {...rest}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .container--content {
    max-width: var(--content-max);
  }

  .container--measure {
    max-width: calc(var(--measure) + 2 * var(--gutter));
  }
</style>
